# Server
NODE_ENV=development
HOST=0.0.0.0
PORT=3000
CORS_ORIGIN=http://127.0.0.1:5173
TRACKER_ALLOWED_ORIGINS=
FRONTEND_ORIGIN=http://127.0.0.1:5173

# PostgreSQL. Use the restricted API login, never the migration login.
DATABASE_URL=postgres://funnellens_api:local-only-change-me@localhost:5432/funnellens_mvp
DATABASE_POOL_MAX=10
DATABASE_SSL=disable

# Supabase Auth + Postgres. Set OWNER_AUTH_SUBJECT to the UUID of the one owner
# account created in Supabase Auth. Use DATABASE_SSL=require for Supabase.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
OWNER_AUTH_SUBJECT=00000000-0000-4000-8000-000000000000
PII_ENCRYPTION_KEY=GENERATE_AND_REPLACE
PII_HMAC_KEY=GENERATE_AND_REPLACE
CREDENTIAL_ENCRYPTION_KEY=GENERATE_AND_REPLACE

# Optional integrations. Configure each provider before using its corresponding API route.
OPENWA_BASE_URL=http://localhost:8000
OPENWA_API_TOKEN=replace-with-random-api-token
OPENWA_WEBHOOK_SECRET=replace-with-a-random-secret
OPENWA_AUTO_REPLY_TEXT=
BACKEND_PUBLIC_URL=http://api:3000
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_AI_MODEL=qwen2.5:0.5b
EXTERNAL_AI_BASE_URL=
EXTERNAL_AI_API_KEY=
EXTERNAL_AI_MODEL=

# SMTP alerting (use a Google App Password, never an account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
ALERT_EMAIL_TO=

# Meta credentials belong in a secret manager in production.
META_APP_ID=
META_APP_SECRET=
META_API_VERSION=
META_REDIRECT_URI=http://127.0.0.1:3000/api/integrations/meta/callback
